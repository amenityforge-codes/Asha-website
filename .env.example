# ASHA Website — Form Submission & Integration Configuration
# ============================================================
# Copy this file to .env for local testing or set these variables in your
# hosting environment (e.g., Vercel Project Settings > Environment Variables).
#
# IMPORTANT: Never commit actual secret keys or credentials to Git.
# .env is ignored in .gitignore.

# ------------------------------------------------------------
# 1. Provider Selection
# ------------------------------------------------------------
# Options: "resend" | "formspree" | "webhook" | "mock"
# When unset in development (NODE_ENV != "production"), defaults to "mock"
# which safely logs submission receipt to the console without external dispatch.
FORM_PROVIDER=resend

# ------------------------------------------------------------
# 2. Secretariat Recipient Addresses (Client to supply)
# ------------------------------------------------------------
# Central recipient for both forms:
FORM_RECIPIENT_EMAIL=secretariat@example.com

# Optional distinct recipients per form type:
# CONTACT_RECIPIENT_EMAIL=secretariat@example.com
# MEMBERSHIP_RECIPIENT_EMAIL=accreditation@example.com

# ------------------------------------------------------------
# 3. Provider Configurations
# ------------------------------------------------------------

# Option A: Resend (Recommended)
RESEND_API_KEY=re_your_api_key_here
FORM_SENDER_EMAIL=ASHA Portal <onboarding@resend.dev>

# Option B: Formspree
# FORMSPREE_CONTACT_URL=https://formspree.io/f/your_contact_id
# FORMSPREE_MEMBERSHIP_URL=https://formspree.io/f/your_membership_id

# Option C: Webhook / CRM (Formkeep, Zapier, Make, custom API)
# FORM_WEBHOOK_URL=https://your-endpoint.example.com/api/asha
# WEBHOOK_SECRET=your_optional_shared_secret

# ------------------------------------------------------------
# 4. Environment
# ------------------------------------------------------------
NODE_ENV=development
